FROM mariadb:latest

# Copiar scripts SQL a la carpeta de inicialización
COPY init.sql /docker-entrypoint-initdb.d/

# Asegurar permisos correctos
RUN chmod 644 /docker-entrypoint-initdb.d/init.sql

# Variables de entorno por defecto (se pueden sobreescribir)
ENV MYSQL_ROOT_PASSWORD=default_root_password
ENV MYSQL_DATABASE=mi_basedatos
ENV MYSQL_USER=mi_usuario
ENV MYSQL_PASSWORD=mi_contraseña